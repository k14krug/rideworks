# Optional RideWorks settings. Copy to .env; keep .env out of Git.
# CLI flags win, then exported environment, then this file, then defaults.
DEBUG=0
RUN_PORT=8766
# Omit RIDEWORKS_DATA_DIR for the project-root data/ store.
# Tests and development may set an explicit disposable directory instead.
# DEBUG enables request timing/status diagnostics only.
# RideWorks uses stdlib HTTP: no interactive debugger or automatic reloader.
# Optional browser-facing nginx origin on your private home network.
# Use your actual hostname/IP and external port; omit path and trailing slash.
# PUBLIC_ORIGIN=http://rideworks.lan

# Optional Strava app credentials for Settings > Strava connect/manual sync.
# Copy this example to ignored .env and enter your app's values there.
# Strava Authorization Callback Domain: PUBLIC_ORIGIN hostname/IP (host only),
# or 127.0.0.1 when PUBLIC_ORIGIN is omitted. Strava must accept that domain.
# Web callback: <PUBLIC_ORIGIN>/strava/callback, otherwise loopback app port.
# CLI OAuth always uses loopback; its callback defaults to port 8772.
# Exported STRAVA_CLIENT_ID / STRAVA_CLIENT_SECRET override these entries.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
